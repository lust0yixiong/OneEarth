{
  "name": "oneearth-next",
  "version": "0.2.0-rc.10",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development node scripts/launch.mjs",
    "build": "tsc --noEmit && vite build && node scripts/compress-assets.mjs",
    "start": "node scripts/launch.mjs",
    "check": "tsc --noEmit",
    "precompute:coverage": "node --import tsx scripts/precompute-coverage.ts",
    "sync:research-data": "node --import tsx scripts/sync-assertion-postgres.ts",
    "sync:haina": "node scripts/sync-haina.mjs",
    "test": "tsx --test src/domain/*.test.ts server/*.test.ts",
    "test:ui": "node scripts/smoke.mjs && tsx scripts/interaction-check.ts",
    "test:data-ui": "node scripts/data-view-check.mjs",
    "test:chat-experience": "node scripts/chat-experience-check.mjs",
    "test:call-history-ui": "node scripts/call-history-check.mjs",
    "test:question-confirmation-ui": "node scripts/question-confirmation-check.mjs",
    "test:chat-home-ui": "node scripts/chat-home-settings-check.mjs",
    "test:layout-ui": "node scripts/chat-layout-check.mjs",
    "test:chat-citation-ui": "node scripts/chat-citation-check.mjs",
    "test:citation-types-ui": "node scripts/citation-types-check.mjs",
    "test:globe-regression": "node scripts/coverage-answer-check.mjs && node scripts/answer-globe-check.mjs && node scripts/globe-performance-check.mjs --assert && node scripts/distribution-heat-check.mjs && node scripts/grid-data-groups-check.mjs",
    "test:answer-globe-ui": "node scripts/answer-globe-check.mjs",
    "test:heatmap-ui": "node scripts/distribution-heat-check.mjs",
    "test:grid-list-ui": "node scripts/grid-data-groups-check.mjs",
    "test:data-access-ui": "node scripts/data-access-check.mjs",
    "test:preview-ui": "node scripts/preview-check.mjs",
    "audit:earth-challenge": "node scripts/earth-challenge-audit.mjs",
    "test:research-ui": "node scripts/research-acceptance.mjs",
    "test:sessions-ui": "node scripts/session-workflow-check.mjs",
    "test:result-links-ui": "node scripts/result-links-check.mjs",
    "test:workspace-ui": "node scripts/workspace-coherence-check.mjs",
    "test:handoff-ui": "node scripts/research-handoff-check.mjs",
    "test:collection-ui": "node scripts/collection-workflow-check.mjs",
    "test:constellation-ui": "node scripts/constellation-workflow-check.mjs",
    "demo:constellation": "node scripts/demo-constellation.mjs",
    "sync:earth-search": "node scripts/sync-earth-search.mjs",
    "test:wind-ui": "node scripts/wind-view-check.mjs",
    "test:search-live": "node scripts/search-live-check.mjs",
    "test:orientation-ui": "node scripts/admin-orientation-check.mjs",
    "test:globe-motion": "node scripts/globe-motion-check.mjs",
    "test:source-preview-ui": "node scripts/source-preview-check.mjs",
    "prepare:haina-forest": "node scripts/prepare-haina-forest.mjs",
    "test:forest-ui": "node scripts/forest-view-check.mjs",
    "prepare:haina-c40": "node scripts/prepare-haina-c40.mjs",
    "test:c40-ui": "node scripts/c40-view-check.mjs",
    "data:prepare": "node scripts/prepare-inputs.mjs",
    "data:seed": "node scripts/launch.mjs seed",
    "test:e2e": "node scripts/accept-first-turn.mjs",
    "backup:sample": "node --import tsx scripts/transfer-sample.ts",
    "status": "node scripts/status.mjs",
    "test:spatial": "node scripts/accept-spatial.mjs",
    "test:fault": "node scripts/accept-fault-and-confirmation.mjs",
    "test:compat": "node scripts/accept-restored.mjs",
    "test:performance": "node scripts/compare-browser.mjs",
    "test:natural": "node scripts/accept-natural-questions.mjs",
    "access:import": "node scripts/import-access-once.mjs",
    "test:numbered-research": "node scripts/accept-numbered-research.mjs",
    "test:research-decisions": "node scripts/accept-research-decisions.mjs",
    "test:managed-release": "node scripts/accept-supervised-release.mjs",
    "test:product-restore": "node scripts/accept-product-restore.mjs",
    "storage:inspect": "node scripts/inspect-product-storage.mjs"
  },
  "dependencies": {
    "@ag-ui/client": "1.0.5",
    "@ag-ui/core": "1.0.5",
    "@aws-sdk/client-s3": "^3.1175.0",
    "@electric-sql/pglite": "^0.5.17",
    "@electric-sql/pglite-postgis": "^0.2.17",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@mozilla/readability": "0.6.0",
    "cesium": "1.147.0",
    "cheerio": "^1.1.2",
    "csv-parse": "^6.2.1",
    "d3-geo": "3.1.1",
    "express": "^5.1.0",
    "fflate": "0.8.2",
    "h3-js": "4.2.1",
    "h5wasm": "^0.10.3",
    "katex": "^0.19.1",
    "lucide-react": "^0.577.0",
    "netcdfjs": "4.0.0",
    "pdfjs-dist": "5.4.624",
    "pg": "^8.23.1",
    "playwright-core": "^1.60.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "s2-geometry": "1.2.10",
    "topojson-client": "3.1.0",
    "world-atlas": "2.0.2"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.0",
    "@types/express": "^5.0.0",
    "@types/node": "^25.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "latest",
    "hyparquet": "^1.33.1",
    "hyparquet-compressors": "^1.1.3",
    "sharp": "^0.35.5",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "8.3.6"
  },
  "engines": {
    "node": ">=22.13"
  }
}
