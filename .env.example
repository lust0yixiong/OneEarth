# 在新工程复制为 .env，或由部署环境提供同名变量。
ONEEARTH_PORT=5274
ONEEARTH_DISCOVERY_PORT=5275
# 发现进程独立选择已有授权的执行器和模型。填写部署值后，A2A 才接受新委托。
# ONEEARTH_DISCOVERY_CHAT_MODEL='{"executor":"codex","model":"deepseek-flash","provider":"deepseek"}'
# 运行时默认使用 A2A，仅连接旧版发现服务时显式指定 v1。
# ONEEARTH_DISCOVERY_PROTOCOL=v1
ONEEARTH_SPATIAL_PORT=5276
# ONEEARTH_RUNTIME_PORT defaults to ONEEARTH_PORT + 3
ONEEARTH_STATE_DIR=.local/state
ONEEARTH_DATA_DIR=.local/globe-data
ONEEARTH_HOST=127.0.0.1
# 可选。只在指定接口的私有 IPv4 地址上额外开放网页工作台。
# ONEEARTH_LAN_INTERFACE=en1
# 独立部署用外部凭据文件的绝对路径，或由部署环境提供下列上游变量。
# ONEEARTH_CREDENTIALS_FILE=
# ONEEARTH_USE_EXISTING_ACCESS=1 仅用于有原型的开发工作区。
ONEEARTH_USE_EXISTING_ACCESS=0
# DEEPSEEK_API_KEY 从凭据来源注入
# ONEEARTH_DEEPSEEK_SEARCH=true
# ONEEARTH_DEEPSEEK_FETCH=true
# ONEEARTH_EARTHNANO_URL=
# ONEEARTH_ASSERTION_PG_HOST=
# ONEEARTH_ASSERTION_PG_PORT=5432
# ONEEARTH_ASSERTION_PG_DATABASE=
# ONEEARTH_ASSERTION_PG_USER=
# ONEEARTH_ASSERTION_PG_PASSWORD 据已有只读权限注入
# HAINA_ACCESS_KEY_ID 和 HAINA_SECRET_ACCESS_KEY 据已有海纳权限注入
# 产品数据库连接串由部署配置或密钥服务注入。
# ONEEARTH_RUNTIME_DATABASE_URL=
# ONEEARTH_DISCOVERY_DATABASE_URL=
# ONEEARTH_SPATIAL_DATABASE_URL=
# PostGIS 扩展在时空数据库中预先启用。
# ONEEARTH_OBJECT_BUCKET=
# ONEEARTH_OBJECT_ENDPOINT=
# ONEEARTH_OBJECT_PREFIX=oneearth/
# ONEEARTH_OBJECT_PATH_STYLE=1
# AWS_REGION=garage
# AWS_ACCESS_KEY_ID 与 AWS_SECRET_ACCESS_KEY 由对象存储授权注入。
